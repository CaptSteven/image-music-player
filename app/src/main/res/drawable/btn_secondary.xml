<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#337CC7FF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape>
                    <solid android:color="#22344558" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <corners android:radius="8dp" />
                    <gradient
                        android:angle="135"
                        android:endColor="@color/panel_bg"
                        android:startColor="@color/panel_bg_soft" />
                    <stroke
                        android:width="1dp"
                        android:color="#667482" />
                    <padding
                        android:bottom="10dp"
                        android:left="14dp"
                        android:right="14dp"
                        android:top="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
